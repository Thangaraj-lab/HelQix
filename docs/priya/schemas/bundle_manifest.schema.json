{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helqix/bundle_manifest.schema.json",
  "title": "HELQIX electronics-result/0.1 manifest",
  "type": "object",
  "required": ["version", "source", "status", "labels", "units", "files"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "electronics-result/0.1"},
    "source": {
      "type": "object",
      "required": ["package", "version"],
      "additionalProperties": false,
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["ok", "solver_error"]},
    "analysis": {"type": ["string", "null"]},
    "validation_label": {"enum": ["VALIDATED", "UNVALIDATED", "CHECKED", null]},
    "labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "units": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["results.json", "values.csv", "series.csv"]},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "code": {"type": ["string", "null"]},
    "message": {"type": ["string", "null"]}
  }
}
