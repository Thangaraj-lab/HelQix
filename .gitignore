# Rust build artifacts
target/

# Cargo.lock stays tracked: the workspace ships binaries and claims reproducible builds.

# Python environments and caches
.venv/
venv/
17-integrations/gateway/.venv/
17-integrations/gateway/__pycache__/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/

# Local runtime data (gateway SQLite store defaults to data/integration_runs.sqlite3)
/data/
/.data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db

# Local secrets
.env
.env.*
!.env.example

# JavaScript dependency and generated build output
node_modules/
dist/
*.tsbuildinfo

.helqix-toolchain/

# Local editor settings and temporary validation artifacts
.vscode/
/scratch/

# Signing keys (development keys only; never commit)
/.keys/
*.key
/.cache/
