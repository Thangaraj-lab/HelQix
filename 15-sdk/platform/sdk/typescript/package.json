{
  "name": "@helqix/sdk",
  "version": "0.1.0",
  "description": "TypeScript client contracts for the HELQIX reality platform",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --declaration --declarationMap --sourceMap --outDir dist src/index.ts",
    "typecheck": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --noEmit src/index.ts",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
