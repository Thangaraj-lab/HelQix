server {
    listen ${HELQIX_STUDIO_PORT};
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://${HELQIX_API_UPSTREAM}/;
        proxy_set_header Authorization "Bearer ${HELQIX_API_KEY}";
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;          # build events stream over SSE
        proxy_read_timeout 300s;      # a local model can take a while
    }

    location / {
        try_files $uri /index.html;
    }
}
